<Window x:Class="TrafficSimulator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficSimulator.UI"
        mc:Ignorable="d"
        Title="Traffic Simulator - Simulador de Tráfico" Height="800" Width="1200"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menú Principal -->
        <Menu Grid.Row="0">
            <MenuItem Header="Archivo">
                <MenuItem Header="Nuevo" Click="MenuNew_Click"/>
                <MenuItem Header="Abrir..." Click="MenuOpen_Click"/>
                <MenuItem Header="Guardar" Click="MenuSave_Click"/>
                <MenuItem Header="Guardar como..." Click="MenuSaveAs_Click"/>
                <Separator/>
                <MenuItem Header="Salir" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Editar">
                <MenuItem Header="Eliminar seleccionado" Click="MenuDelete_Click"/>
                <MenuItem Header="Limpiar todo" Click="MenuClear_Click"/>
            </MenuItem>
            <MenuItem Header="Simulación">
                <MenuItem Header="Generar vehículos" Click="MenuGenerateVehicles_Click"/>
                <MenuItem x:Name="menuStartSimulation" Header="Iniciar" Click="MenuStartSimulation_Click"/>
                <MenuItem x:Name="menuPauseSimulation" Header="Pausar" Click="MenuPauseSimulation_Click"/>
                <MenuItem x:Name="menuStopSimulation" Header="Detener" Click="MenuStopSimulation_Click"/>
            </MenuItem>

            <MenuItem Header="Análisis">
                <MenuItem Header="Puntos críticos" Click="MenuCriticalPoints_Click"/>
                <MenuItem Header="Recomendaciones" Click="MenuRecommendations_Click"/>
            </MenuItem>
            <MenuItem Header="Ayuda">
                <MenuItem Header="Acerca de..." Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- Barra de Herramientas -->
        <ToolBar Grid.Row="1">
            <Button x:Name="btnNew" Content="Nuevo" Click="BtnNew_Click"/>
            <Button x:Name="btnOpen" Content="Abrir" Click="BtnOpen_Click"/>
            <Button x:Name="btnSave" Content="Guardar" Click="BtnSave_Click"/>
            <Separator/>

            <ToggleButton x:Name="tglSelect" Content="Seleccionar" IsChecked="True" Click="TglSelect_Click"/>
            <ToggleButton x:Name="tglAddCity" Content="Agregar Ciudad" Click="TglAddCity_Click"/>
            <ToggleButton x:Name="tglAddRoad" Content="Agregar Carretera" Click="TglAddRoad_Click"/>
            <Separator/>

            <Button x:Name="btnGenerateVehicles" Content="Generar Vehículos" Click="BtnGenerateVehicles_Click"/>
            <Button x:Name="btnStartSimulation" Content="▶ Iniciar" Click="BtnStartSimulation_Click"/>
            <Button x:Name="btnPauseSimulation" Content="⏸ Pausar" IsEnabled="False" Click="BtnPauseSimulation_Click"/>
            <Button x:Name="btnStopSimulation" Content="⏹ Detener" IsEnabled="False" Click="BtnStopSimulation_Click"/>
        </ToolBar>

        <!-- Área Principal -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Editor de Grafo -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1">
                <ContentControl x:Name="graphEditorContainer"/>
            </Border>

            <!-- Separador -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Panel de Propiedades -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- Panel de Propiedades -->
                <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="5">
                    <ContentControl x:Name="propertiesPanelContainer"/>
                </Border>

                <!-- Separador -->
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Panel de Información -->
                <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Margin="5">
                    <ScrollViewer>
                        <StackPanel Margin="10">
                            <TextBlock Text="Información de la Simulación" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <TextBlock Text="Estadísticas:"/>
                            <TextBlock x:Name="txtStatistics" Margin="10,5,0,10"/>

                            <TextBlock Text="Vehículo seleccionado:"/>
                            <TextBlock x:Name="txtSelectedVehicle" Margin="10,5,0,10"/>

                            <Button Content="Mostrar Puntos Críticos" Click="BtnShowCriticalPoints_Click" Margin="0,5"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Barra de Estado -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Listo"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ciudades: "/>
                    <TextBlock x:Name="txtCityCount" Text="0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Carreteras: "/>
                    <TextBlock x:Name="txtRoadCount" Text="0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Vehículos: "/>
                    <TextBlock x:Name="txtVehicleCount" Text="0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Simulación: "/>
                    <TextBlock x:Name="txtSimulationStatus" Text="Detenida"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>